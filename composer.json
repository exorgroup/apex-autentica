{
    "name": "apex/autentica",
    "type": "laravel-package",
    "description": "Enterprise-grade authentication and authorization package for Laravel applications",
    "keywords": [
        "laravel",
        "authentication",
        "authorization",
        "security",
        "mfa",
        "permissions",
        "oauth",
        "enterprise"
    ],
    "homepage": "https://github.com/your-org/apex-autentica",
    "license": "MIT",
    "authors": [
        {
            "name": "EXOR Group",
            "email": "support@exorgroup.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Apex\\Autentica\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Apex\\Autentica\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Apex\\Autentica\\AutenticaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}