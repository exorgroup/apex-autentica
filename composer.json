{
    "name": "exorgroup/apex-autentica",
    "type": "laravel-package",
    "description": "Authentication and authorization for Laravel: groups, resource permissions, MFA, sessions and security logging",
    "keywords": [
        "laravel",
        "authentication",
        "authorization",
        "security",
        "mfa",
        "permissions",
        "oauth",
        "enterprise"
    ],
    "homepage": "https://github.com/exorgroup/apex-autentica",
    "license": [
        "MIT",
        "proprietary"
    ],
    "authors": [
        {
            "name": "EXOR Group",
            "email": "support@exorgroup.com"
        }
    ],
    "support": {
        "issues": "https://github.com/exorgroup/apex-autentica/issues",
        "source": "https://github.com/exorgroup/apex-autentica"
    },
    "require": {
        "php": "^8.2",
        "exorgroup/apex-signature": "^0.1",
        "illuminate/support": "^11.0|^12.0",
        "laravel/framework": "^11.0|^12.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Apex\\Autentica\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Apex\\Autentica\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Apex\\Autentica\\AutenticaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/exorgroup/apex-signature.git"
        }
    ]
}
